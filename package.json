{
  "name": "nfse-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Serviço da NFS-e (ADN / Sefin Nacional) do Gestão 2027 — porta 3002, /v1 (D-F8/D-F12/D-F17)",
  "scripts": {
    "dev": "tsx watch --require tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/write-build-info.mjs",
    "start": "node dist/server.js",
    "predeploy:check": "node dist/pre-deploy-cli.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --forceExit",
    "db:migrate": "tsx --require tsconfig-paths/register scripts/migrate.ts",
    "migrate:setes": "tsx --require tsconfig-paths/register scripts/migrate-from-setes-api.ts",
    "token:dev": "tsx --require tsconfig-paths/register scripts/mint-dev-token.ts",
    "explain:leituras": "tsx --require tsconfig-paths/register scripts/explain-leituras.ts",
    "smoke:adn-h": "tsx --require tsconfig-paths/register scripts/smoke-adn-homologacao.ts"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fiscal-api": "file:vendor/fiscal-api-1.0.0.tgz",
    "pdfkit": "^0.20.2",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.5.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.3",
    "node-forge": "^1.4.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
